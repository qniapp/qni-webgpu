[[ $(type -t module) == "function" ]] && export -f module

port=$(find_port)
backend_port=$(find_port)
if [[ "${backend_port}" == "${port}" ]]; then
  backend_port=$(python3 - <<PY
import socket
frontend_port = int("${port}")
while True:
    sock = socket.socket()
    sock.bind(("127.0.0.1", 0))
    candidate = sock.getsockname()[1]
    sock.close()
    if candidate != frontend_port:
        print(candidate)
        break
PY
)
fi
