{
  "extends": ["html-validate:recommended"],
  "rules": {
    "void-style": "off",
    "no-trailing-whitespace": "off",
    "no-inline-style": "off",
    "doctype-style": "off",
    "no-implicit-button-type": "off",
    "wcag/h30": "off",
    "wcag/h32": "off",
    "wcag/h36": "off",
    "wcag/h37": "off",
    "wcag/h63": "off",
    "wcag/h67": "off",
    "wcag/h71": "off",
    "long-title": "off",
    "no-redundant-role": "off",
    "no-self-closing": "off",
    "require-sri": "off",
    "prefer-button": "off",
    "attribute-allowed-values": "off",
    "attr-quotes": "off",
    "element-required-attributes": "warn",
    "element-required-content": "warn",
    "no-deprecated-attr": "warn",
    "no-dup-attr": "error",
    "no-dup-id": "error",
    "close-attr": "error",
    "close-order": "error",
    "void-content": "error"
  }
}
