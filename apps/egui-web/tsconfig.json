{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["cucumber.ts", "features/**/*.ts", "features/**/*.d.ts", "playwright.config.ts", "scripts/**/*.ts", "test-node/**/*.ts", "tests/**/*.ts", "test-support/**/*.ts"]
}
